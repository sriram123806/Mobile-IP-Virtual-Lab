# Copy to .env and fill in. NEVER commit .env or put keys in frontend code.
# --- Language model (generation). Leave both keys empty to run without an LLM (shows retrieved passages only).
LLM_PROVIDER=auto            # auto | anthropic | openai | none
ANTHROPIC_API_KEY=
LLM_MODEL=                   # default: claude-sonnet-5-5 (Anthropic) or gpt-4o-mini (OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=             # optional, for OpenAI-compatible servers

# --- Embeddings
EMBEDDING_PROVIDER=auto      # auto (local MiniLM, falls back to offline hash) | onnx | openai | hash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Web
ALLOWED_ORIGINS=http://localhost:8000,https://YOUR-USERNAME.github.io   # comma separated; origins only, no paths
ADMIN_TOKEN=                 # >= 8 chars; required for the admin page/API
RATE_LIMIT_PER_MIN=20
MAX_UPLOAD_MB=25

# --- Paths / tuning (optional)
# KB_DIR=./knowledge_base
# DATA_DIR=./data
# TOP_K=6
# CHUNK_CHARS=1400
# CHUNK_OVERLAP=150
# AUTO_INDEX_ON_START=true
# CREATOR_TEXT=
